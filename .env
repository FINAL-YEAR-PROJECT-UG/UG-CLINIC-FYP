# Copy to project root as .env before running: docker compose up -d --build

# Database
POSTGRES_DB=
POSTGRES_USER=
DB_PASSWORD=
POSTGRES_PORT=

# Redis
REDIS_PORT=6379

# Application URLs (browser-facing)
API_URL=
FRONTEND_URL=
CORS_ORIGIN=
BACKEND_PORT=
FRONTEND_PORT=

# Frontend build-time variables
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=

# Security
JWT_SECRET=change-me-to-a-secret-with-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info

# File upload
MAX_FILE_SIZE=10485760
MAX_VIDEO_SIZE=104857600

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
