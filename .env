# Copy to project root as .env before running: docker compose up -d --build

# Database
POSTGRES_DB=ug_clinic
POSTGRES_USER=postgres
DB_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Application URLs (browser-facing)
API_URL=http://10.107.9.172:3005
FRONTEND_URL=http://10.107.9.172:3001
CORS_ORIGIN=http://10.107.9.172:3001,http://localhost:3001,http://10.107.9.172:3005,http://localhost:3005
BACKEND_PORT=3005
FRONTEND_PORT=3001

# Frontend build-time variables
NEXT_PUBLIC_API_URL=http://10.107.9.172:3005/api
NEXT_PUBLIC_APP_NAME=UG-CLINIC-FYP
NEXT_PUBLIC_APP_URL=http://10.107.9.172:3001

# Security
JWT_SECRET=change-me-to-a-secret-with-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info

# File upload
MAX_FILE_SIZE=10485760
MAX_VIDEO_SIZE=104857600

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@ugclinic-fyp.edu.gh
FROM_NAME=UG Clinic FYP

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
