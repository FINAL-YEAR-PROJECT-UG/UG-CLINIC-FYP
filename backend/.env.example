# Security Configuration
NODE_ENV=development
LOG_LEVEL=info

# Server Configuration
PORT=3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ug-clinic

# JWT Configuration
JWT_SECRET=your-super-secret-key-with-at-least-32-characters-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Configuration
BCRYPT_ROUNDS=12

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=3

# Email Configuration (for password reset, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@ugclinic.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png
UPLOAD_DIR=./uploads

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
HELMET_ENABLED=true
INPUT_SANITIZATION_ENABLED=true
SECURITY_LOG_ENABLED=true
