generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  RECEPTIONIST
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum NotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  RESOURCE_UPLOADED
  SYSTEM_ANNOUNCEMENT
  PASSWORD_RESET
}

enum NotificationSentVia {
  EMAIL
  SMS
  IN_APP
}

model User {
  id                  String            @id @default(uuid())
  studentId           String?           @unique
  email               String            @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  role                UserRole          @default(STUDENT)
  isActive            Boolean           @default(true)
  emailVerified      Boolean           @default(false)
  phoneVerified      Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lastLoginAt         DateTime?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  refreshTokens       RefreshToken[]

  appointments        Appointment[]     @relation("UserAppointments")
  doctorAppointments  Appointment[]     @relation("DoctorAppointments")
  resources           Resource[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  loginAttempts       FailedLoginAttempt[]
}

model Appointment {
  id              String            @id @default(uuid())
  userId          String
  doctorId        String?
  serviceId       String
  date            DateTime
  timeSlot        String
  status          AppointmentStatus @default(PENDING)
  notes           String?
  reason          String
  cancelledBy     String?
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation("UserAppointments", fields: [userId], references: [id])
  doctor          User?             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  service         Service           @relation(fields: [serviceId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
  @@index([status])
  @@index([date, timeSlot])
}

model Service {
  id           String        @id @default(uuid())
  name         String
  description  String?
  duration     Int
  category     String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  appointments Appointment[]
  timeSlots    TimeSlot[]
}

model TimeSlot {
  id              String   @id @default(uuid())
  serviceId       String
  date            DateTime
  startTime       String
  endTime         String
  isAvailable     Boolean  @default(true)
  maxBookings     Int      @default(1)
  currentBookings Int      @default(0)
  createdAt       DateTime @default(now())

  service         Service  @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, date, startTime])
  @@index([date])
  @@index([date, isAvailable])
}

model Resource {
  id            String   @id @default(uuid())
  title         String
  description   String?
  fileUrl       String
  fileType      String
  fileSize      Int
  category      String
  tags          String[]
  isPublic      Boolean  @default(false)
  uploadedBy    String
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  uploader      User     @relation(fields: [uploadedBy], references: [id])

  @@index([category])
  @@index([isPublic])
}

model Notification {
  id        String                @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean               @default(false)
  sentVia   NotificationSentVia   @default(IN_APP)
  createdAt DateTime              @default(now())

  user      User                  @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model FailedLoginAttempt {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
